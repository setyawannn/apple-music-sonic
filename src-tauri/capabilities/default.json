{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Apple Music RS",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "fs:default",
    "fs:allow-read",
    "fs:allow-exists",
    "shell:default",
    "process:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
